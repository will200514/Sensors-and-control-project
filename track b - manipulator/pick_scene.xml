
<mujoco model="UR3e Vision Guided Pick">

    <!-- Load the existing UR3e robot -->
    <include file="../universal_robots_ur3e/ur3e.xml"/>

    <visual>
        <global azimuth="135" elevation="-25"/>
    </visual>

    <worldbody>

        <!-- Ground -->
        <geom name="ground"
              type="plane"
              size="2 2 0.1"
              rgba="0.85 0.85 0.85 1"/>

        <!-- Lighting -->
        <light name="overhead_light"
               pos="0 0 3"
               dir="0 0 -1"/>

        <!-- Table -->
        <body name="table" pos="0.45 0 0.35">
            <geom name="table_surface"
                  type="box"
                  size="0.3 0.3 0.025"
                  rgba="0.6 0.45 0.3 1"/>
        </body>

        <!-- Target cube -->
        <body name="target_cube" pos="0.35 0 0.55">

            <freejoint/>

            <geom name="cube_geom"
                  type="box"
                  size="0.025 0.025 0.025"
                  rgba="1 0 0 1"
                  mass="0.1"/>

        </body>

    </worldbody>

</mujoco>
